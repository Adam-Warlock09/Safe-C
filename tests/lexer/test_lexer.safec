struct Node {
    int value;
    own Node*? next; // Owns the remainder of the list, or null at the tail
};
struct List {
    own Node*? head; // Owns the first node, transitively owning the entire chain
};
List list_new() {
    return (List){ .head = null };
}
// Mutates the list’s head pointer, requiring a write borrow (mut List*).
void list_push(mut List* list, int value) {
own Node* n = new Node;
n->value = value;
n->next = list->head; // Move: previous head chain now belongs to n->next
list->head = n; // Move: ownership of n transfers into list->head
}
// Mutates both the list and the caller’s output integer via write borrows.
bool list_pop(mut List* list, mut int* out_value) {
if (list->head == null) return false;
own Node* n = list->head; // Move front node out (narrowed to non-null own
Node*)
list->head = n->next; // Move remaining chain back into list->head
n->next = null; // Detach downstream ownership before freeing n
*out_value = n->value; // Write result through mutable borrow out_value
free(n); // Consume and deallocate the detached node n
return true;
}
// Read-only traversal: takes an immutable read borrow (List*) and never alters
ownership.
void list_print(List* list) {
Node*? cur = list->head; // Nullable read borrow of the head node
while (cur != null) { // Narrows cur to non-nullable Node* inside loop
body
printf("%d ", cur->value);
cur = cur->next; // Advance read borrow to the next node
}
printf("\n");
}
// Releases all heap nodes by walking the chain through a write borrow.
void list_free(mut List* list) {
own Node*? cur = list->head;
list->head = null; // Leave the borrowed List in a valid empty state
while (cur != null) {
own Node* n = cur; // Move narrowed non-null node out of cur
cur = n->next; // Move remainder of the chain into cur
n->next = null; // Clear child owner before deallocation
free(n); // Safely release current node
}
}
int main() {
List list = list_new();
list_push(&mut list, 1);
list_push(&mut list, 2);
list_push(&mut list, 3);
list_print(&list); // Outputs: 3 2 1
int x;
list_pop(&mut list, &mut x);
printf("popped: %d\n", x); // Outputs: popped: 3
list_print(&list); // Outputs: 2 1
list_free(&mut list);
return 0;
}