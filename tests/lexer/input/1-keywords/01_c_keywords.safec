void display(int value) {
    while (value > 0) {
        if (value == 5) {
            break;
        } else {
            value--;
        }
    }
}

int main() {
    struct Student {
        int roll;
        char grade;
        float marks;
    };

    int i = 0;
    bool passed = true;

    for (i = 0; i < 5; i++) {
        if (passed) {
            display(i);
        } else {
            continue;
        }
    }

    switch (i) {
        case 5:
            break;
        default:
            return 1;
    }

    return 0;
}