int main() {
    int i = 0;

    for (i = 0; i < 10; i++) {
        if (i == 3) {
            continue;
        }

        if (i == 8) {
            break;
        }
    }

    while (i > 0) {
        i = i - 1;
    }

    switch (i) {
        case 0:
            return 0;
        default:
            return 1;
    }
}