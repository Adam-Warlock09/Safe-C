/* if / else / else-if chains, single-statement bodies, nesting. */
int classify(int n) {
    if (n < 0)
        return -1;
    else if (n == 0) {
        return 0;
    } else
        return 1;
}

int main() {
    int x = 5;
    if (x > 0) {
        if (x > 10) {
            x = 10;
        } else {
            x = x + 1;
        }
    }
    return classify(x);
}
