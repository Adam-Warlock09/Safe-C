/* Relational, equality, bitwise, shift and logical operators with
   their relative precedence. */
bool check(int a, int b, int c) {
    bool r1 = a < b;
    bool r2 = a <= b;
    bool r3 = a > b;
    bool r4 = a >= b;
    bool r5 = a == b;
    bool r6 = a != b;
    bool r7 = a < b && b < c;
    bool r8 = a == b || c != 0 && b > 1;
    bool r9 = !(a == b) || a != b;
    bool bits = (a & 1) | (b ^ 2) & ~c;
    bool sh = (a << 1) > (b >> 2);
    bool chained_assign = a != (b = c);
    return r1 && r7 || r9;
}

int main() {
    if (check(1, 2, 3)) {
        return 1;
    }
    return 0;
}
