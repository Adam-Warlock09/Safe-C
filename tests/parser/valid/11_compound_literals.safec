/* Compound literals `(Type) { ... }` with designated initializers
   (the form used in the whitepaper's linked-list case study) and,
   since the grammar also accepts it, one positional initializer. */
struct Vec {
    int x;
    int y;
};

struct Vec origin() {
    return (struct Vec){ .x = 0, .y = 0 };
}

struct Vec unit_x() {
    return (struct Vec){ .x = 1, .y = 0 };
}

struct Vec flipped(int a, int b) {
    return (struct Vec){ b, a };
}

int main() {
    struct Vec v = (struct Vec){ .y = 2, .x = 1 };
    return v.x + v.y;
}
