// Demo 8: the whitepaper's case study, a singly linked list (section 6).
//
// Everything together: nodes owned through `own Node*? next`, moves when
// pushing and popping, nullable pointers narrowed by `while (cur != null)`,
// read and write borrows of the list, and printf. Prints exactly what the
// whitepaper shows: "3 2 1", "popped: 3", "2 1".
// The README ("The whitepaper's case study") lists what differs from the
// whitepaper's text and why.
// demo: run

struct Node {
    int value;
    own struct Node*? next;      // Owns the remainder of the list, or null at the tail
};

struct List {
    own struct Node*? head;      // Owns the first node, transitively owning the entire chain
};

struct List list_new() {
    return (struct List){ .head = null };
}

// Mutates the list's head pointer, requiring a write borrow (mut List*).
void list_push(mut struct List* list, int value) {
    own struct Node* n = new struct Node;
    n->value = value;
    n->next = list->head;       // Move: previous head chain now belongs to n->next
    list->head = n;             // Move: ownership of n transfers into list->head
}

// Mutates both the list and the caller's output integer via write borrows.
bool list_pop(mut struct List* list, mut int* out_value) {
    if (list->head == null) return false;

    own struct Node* n = list->head;   // Move front node out (narrowed to non-null own Node*)
    list->head = n->next;       // Move remaining chain back into list->head
    n->next = null;             // Detach downstream ownership before freeing n
    *out_value = n->value;      // Write result through mutable borrow out_value
    free(n);                    // Consume and deallocate the detached node n
    return true;
}

// Read-only traversal: takes an immutable read borrow (List*) and never alters ownership.
void list_print(struct List* list) {
    struct Node*? cur = list->head;     // Nullable read borrow of the head node
    while (cur != null) {               // Narrows cur to non-nullable Node* inside loop body
        printf("%d ", cur->value);
        cur = cur->next;                // Advance read borrow to the next node
    }
    printf("\n");
}

// Releases a chain of nodes it takes ownership of (the whitepaper's list_free,
// taking the chain itself instead of a write borrow of the list).
void nodes_free(own struct Node*? cur) {
    while (cur != null) {
        own struct Node* n = cur;       // Move narrowed non-null node out of cur
        cur = n->next;                  // Move remainder of the chain into cur
        n->next = null;                 // Clear child owner before deallocation
        free(n);                        // Safely release current node
    }
}

int main() {
    struct List list = list_new();
    list_push(&mut list, 1);
    list_push(&mut list, 2);
    list_push(&mut list, 3);
    list_print(&list);                  // Outputs: 3 2 1

    int x = 0;
    list_pop(&mut list, &mut x);
    printf("popped: %d\n", x);          // Outputs: popped: 3
    list_print(&list);                  // Outputs: 2 1

    own struct Node*? chain = list.head;    // take the nodes out of the list
    list.head = null;                       // the list is now visibly empty
    nodes_free(chain);                      // and hand them over to be freed
    return 0;
}
