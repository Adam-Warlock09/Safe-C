// Demo 6: an array index out of bounds stops the program.
//
// In C, reading scores[5] of a 5-element array silently reads whatever lies
// next in memory (or writes over it: a buffer overflow). SafeC checks every
// index it can't prove safe, and stops the program at the bad access.
// demo: trap

int main() {
    int scores[5];
    for (int i = 0; i < 5; i++) {
        scores[i] = i * 10;
    }
    printf("scores[4] = %d\n", scores[4]);

    int index = 5;                         // off by one
    printf("reading scores[%d] ...\n", index);
    printf("%d\n", scores[index]);         // stopped here
    printf("never printed\n");
    return 0;
}
