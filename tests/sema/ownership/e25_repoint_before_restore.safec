// M5 when a mut borrow is pointed elsewhere before restoring
struct Node { int v; own struct Node*? next; };

void free_list(own struct Node*? n) {
    while (n != null) {
        own struct Node*? nx = n->next;
        n->next = null;
        free(n);
        n = nx;
    }
}

void f(mut struct Node* a, mut struct Node* b) {
    mut struct Node* m = a;
    own struct Node*? t = m->next;
    m = b;              // error: 'm->next' was moved out of borrowed data and not restored
    free_list(t);
}
