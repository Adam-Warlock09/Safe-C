// Float arithmetic and comparisons.
// Returns the number of the first check that fails, 0 if all pass.

int main() {
    float x = 2.5;
    float y = 0.5;
    if (x + y != 3.0) return 1;
    if (x - y != 2.0) return 2;
    if (x * y != 1.25) return 3;
    if (x / y != 5.0) return 4;
    if (!(x > y)) return 5;
    if (x <= y) return 6;
    if (-x != 0.0 - 2.5) return 7;
    float z = x * 2 + 1;                        // int operands promote to float
    if (z != 6.0) return 8;
    return 0;
}
