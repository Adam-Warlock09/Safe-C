// if/else, while, for, break, continue and switch.
// Returns the number of the first check that fails, 0 if all pass.

int classify(int v) {
    switch (v) {
        case 0:
            return 10;
        case 1:
        case 2:                                 // case 1 falls through
            return 20;
        case 'a':
            return 30;
        default:
            return 40;
    }
    return 50;
}

int fallthrough(int v) {
    int r = 0;
    switch (v) {
        case 0: r = r + 1;
        case 1: r = r + 10;
        case 2: r = r + 100; break;
        case 3: r = 1000;
    }
    return r;
}

int main() {
    int r = 0;
    if (r == 0) r = 1; else r = 2;
    if (r != 1) return 1;

    int s = 0;
    int n = 0;
    while (n < 10) {
        n = n + 1;
        if (n == 3) continue;                   // skip 3
        if (n == 7) break;                      // stop at 7
        s = s + n;
    }
    if (s != 18) return 2;                      // 1+2+4+5+6

    s = 0;
    for (int i = 0; i < 5; i++) {
        if (i == 1) continue;                   // the step still runs
        s = s + i;
    }
    if (s != 9) return 3;                       // 0+2+3+4

    s = 0;
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            if (j == 2) break;                  // only leaves the inner loop
            s = s + 1;
        }
    }
    if (s != 8) return 4;

    n = 0;
    for (;;) {
        n = n + 1;
        if (n == 5) break;
    }
    if (n != 5) return 5;

    if (classify(0) != 10) return 6;
    if (classify(1) != 20) return 7;
    if (classify(2) != 20) return 8;
    if (classify('a') != 30) return 9;
    if (classify(99) != 40) return 10;
    if (fallthrough(0) != 111) return 11;
    if (fallthrough(2) != 100) return 12;
    if (fallthrough(3) != 1000) return 13;
    if (fallthrough(9) != 0) return 14;         // no case, no default
    return 0;
}
