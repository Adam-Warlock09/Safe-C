// Assignment, compound assignment, ++ and --.
// Returns the number of the first check that fails, 0 if all pass.

int main() {
    int x = 10;
    x += 5;   if (x != 15) return 1;
    x -= 3;   if (x != 12) return 2;
    x *= 2;   if (x != 24) return 3;
    x /= 5;   if (x != 4) return 4;
    x %= 3;   if (x != 1) return 5;
    x <<= 3;  if (x != 8) return 6;
    x >>= 1;  if (x != 4) return 7;
    x |= 3;   if (x != 7) return 8;
    x &= 5;   if (x != 5) return 9;
    x ^= 1;   if (x != 4) return 10;

    int y = x++;                                // postfix: old value
    if (y != 4 || x != 5) return 11;
    y = ++x;                                    // prefix: new value
    if (y != 6 || x != 6) return 12;
    y = x--;
    if (y != 6 || x != 5) return 13;
    y = --x;
    if (y != 4 || x != 4) return 14;

    int a;
    int b;
    a = b = 9;                                  // assignment is right-associative
    if (a != 9 || b != 9) return 15;
    return 0;
}
