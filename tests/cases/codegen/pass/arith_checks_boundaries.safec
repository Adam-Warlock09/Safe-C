// Runtime arithmetic checks only stop real overflow, division by zero and
// bad shift amounts: values right at the limits must work. Inside trusted
// nothing is checked and overflow wraps around. The trap_*.safec tests
// check each case that must stop the program.
// Returns the number of the first check that fails, 0 if all pass.

int main() {
    int max = 2147483647;
    int min = -2147483647 - 1;

    if (max - 1 + 1 != max) return 1;            // reaching INT_MAX is fine
    if (min + 1 - 1 != min) return 2;            // and INT_MIN
    if (-max != min + 1) return 3;               // negating INT_MAX is fine
    if (min / 1 != min) return 4;
    if (max / -1 != -max) return 5;              // only INT_MIN / -1 overflows
    if (min / 2 != -1073741824) return 6;
    if (-7 % 3 != -1) return 7;                  // remainder keeps the sign, as in C
    if (min % 1 != 0) return 8;
    if (46340 * 46340 != 2147395600) return 9;   // the largest square that fits
    if ((1 << 30) + ((1 << 30) - 1) != max) return 10;
    if (1 << 31 != min) return 11;               // a shift may reach the sign bit
    if (max >> 31 != 0) return 12;
    if (min >> 31 != -1) return 13;              // >> keeps the sign
    if (1 << 0 != 1) return 14;

    int x = max - 1;
    x++;                                         // ++ up to INT_MAX is fine
    if (x != max) return 15;
    x -= 1;
    x *= 1;
    if (x != max - 1) return 16;

    char c = 127;
    c++;                                         // char arithmetic is done in int: no overflow,
    if (c != -128) return 17;                    // the result wraps when stored back

    // trusted: no checks, overflow wraps around
    int wrapped = 0;
    trusted {
        wrapped = max + 1;
    }
    if (wrapped != min) return 18;
    trusted {
        wrapped = -min;
    }
    if (wrapped != min) return 19;
    return 0;
}
