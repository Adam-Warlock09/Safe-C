// switch values, global initializers, shadowed names, defer with shadowing,
// struct values, string escapes and && / || inside long loops.
// Returns the number of the first check that fails, 0 if all pass.

int g_int = 6 * 7;
int g_neg = -5;
char g_char = 'z';
bool g_bool = 2;                                // nonzero converts to true
float g_float = 3;                              // int converts to float
float g_half = -0.5;
int g_from_float = 2.75;                        // float converts to int: 2
int g_zero;

struct Pair { int x; int y; };

struct Pair make_pair(int x, int y) {
    return (struct Pair){ x, y };
}

int classify(char c) {
    switch (c) {
        case 'a': return 1;
        case -1: return 2;
        case 300: return 3;                     // never matches a char, as in C
        case 'b': {
            int local = 10;                     // a local inside a case
            return local;
        }
        default: return 0;
    }
}

int t1(int t1) {                                // a parameter named like a temporary
    int t2 = t1 + 1;
    return t2;
}

int shadow(int x) {
    int r = x;                                  // 1
    {
        int x = 10;
        r = r * 100 + x;                        // 110
        {
            int x = 7;
            r = r + x;                          // 117
        }
    }
    return r + x;                               // 118
}

int trace;

void defer_sees_outer() {
    int v = 3;
    defer trace = trace * 10 + v;               // the outer v, even when run from inside the block
    {
        int v = 9;
        trace = v;
        return;
    }
}

float half(int n) {
    if (n > 0) return 0.5;
    else return -0.5;
}

int count_pairs(int n) {
    int hits = 0;
    int i = 0;
    while (i < n) {
        if ((i % 3 == 0 && i % 5 == 0) || (i % 7 == 0 && !(i % 2 == 0))) hits = hits + 1;
        i++;
    }
    return hits;
}

int ends(int a[3]) {                           // a sized array parameter
    return a[0] + a[2];
}

void set_first(int a[], int v) {               // arrays are passed by reference
    a[0] = v;
}

void defer_block() {
    defer {
        int w = 4;                              // a local inside a deferred block
        trace = trace * 10 + w;
    }
    trace = 1;
}

int main() {
    if (g_int != 42) return 1;
    if (g_neg != -5) return 2;
    if (g_char != 'z') return 3;
    if (!g_bool) return 4;
    if (g_float != 3.0) return 5;
    if (g_half != -0.5) return 6;
    if (g_from_float != 2) return 7;
    if (g_zero != 0) return 9;

    if (classify('a') != 1) return 10;
    if (classify('b') != 10) return 11;
    if (classify('q') != 0) return 12;
    char m = -1;
    if (classify(m) != 2) return 13;
    if (classify(',') != 0) return 14;          // ',' is 44 = 300 % 256: still no match

    if (t1(4) != 5) return 15;
    if (shadow(1) != 118) return 16;

    trace = 0;
    defer_sees_outer();
    if (trace != 93) return 17;

    if (make_pair(3, 4).y != 4) return 18;
    struct Pair p = make_pair(5, 6);
    if (p.x != 5) return 19;
    if (half(1) != 0.5 || half(0) != -0.5) return 20;

    // && and || in a loop of a million iterations: no stack growth per iteration
    int hits = count_pairs(1000000);
    int expect = 0;
    for (int i = 0; i < 1000000; i++) {
        bool a = i % 3 == 0;
        bool b = i % 5 == 0;
        bool c = i % 7 == 0;
        bool d = i % 2 == 0;
        if (a) { if (b) { expect++; continue; } }
        if (c) { if (!d) expect++; }
    }
    if (hits != expect) return 21;

    int three[3];
    three[0] = 1; three[1] = 2; three[2] = 3;
    if (ends(three) != 4) return 23;
    set_first(three, 8);
    if (three[0] != 8) return 24;

    trace = 0;
    defer_block();
    if (trace != 14) return 25;

    char* s = "q\"\\\t\n";
    if (*s != 'q') return 22;
    return 0;
}
