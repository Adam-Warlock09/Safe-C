// After `p != null &&`, the right-hand side may use p as non-null: it only runs
// when p isn't null.
struct Node { int v; own struct Node*? next; };

int positive(struct Node*? p) {
    if (p != null && p->v > 0) {
        return 1;
    }
    return 0;
}

int main() {
    return positive(null);
}
