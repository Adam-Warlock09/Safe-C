// Bug 9: writing through a read borrow (T*) is accepted. Only own and mut
// pointers may be written through.

struct S {
    int f;
};

struct Grid {
    int arr[4];
};

void assign_deref(int* p) {
    *p = 1;                         // error
}

void assign_field(struct S* s) {
    s->f = 2;                       // error
}

void increment_through(int* p) {
    (*p)++;                         // error
}

void compound_assign_through(int* p) {
    *p += 1;                        // error
}

void mut_borrow_through(struct S* s) {
    mut int* m = &mut s->f;         // error
}

void array_field_behind_read_borrow(struct Grid* g) {
    g->arr[0] = 3;                  // error -- arr is only reachable through g
}

void inside_trusted_is_fine(int* p) {
    trusted {
        *p = 1;                     // no error: trusted turns this check off, as in the borrow checker
    }
}

void through_mut_is_fine(mut int* p) {
    *p = 1;                         // no error: mut borrows may write
}
