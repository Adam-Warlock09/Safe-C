/* Struct definitions with plain fields, owning nullable pointer
   fields, and struct-typed variables (always spelled with the
   'struct' keyword).  Also field access (.), arrow access (->)
   and address-of in calls. */
struct Point {
    int x;
    int y;
};

struct Pair {
    struct Point a, b;
    struct Point c;
    struct Point* next;
};

int area(struct Point* p) {
    return p->x * p->y;
}

int main() {
    struct Point pt;
    pt.x = 3;
    pt.y = 4;
    struct Pair pr;
    pr.a = pt;
    pr.c.x = pt.x + pr.b.x;
    return area(&pt);
}
