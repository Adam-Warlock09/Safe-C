/* while and for loops, break and continue, empty for-header parts,
   and declarations inside a for header. */
int sum(int n) {
    int total = 0;
    int i = 0;

    while (i < n) {
        total = total + i;
        i = i + 1;
    }

    for (int j = 0; j < n; j = j + 1) {
        total = total + j;
    }

    for (int q = 0, w = 1; q < n; q = q + w) {
        total = total + 1;
    }

    for (;;) {
        break;
    }

    for (i = 0; ; i = i + 1) {
        if (i > 3) break;
        continue;
    }

    return total;
}

int main() {
    return sum(10);
}
