// Prime sieve: array indices computed in loops (bounds checks), i * i (overflow check).
bool composite[2000000];
int main() {
    int total = 0;
    for (int round = 0; round < 10; round++) {
        for (int i = 0; i < 2000000; i++) { composite[i] = false; }
        int count = 0;
        for (int i = 2; i < 2000000; i++) {
            if (!composite[i]) {
                count++;
                if (i < 1415) {
                    for (int j = i * i; j < 2000000; j += i) { composite[j] = true; }
                }
            }
        }
        total += count;
    }
    printf("%d\n", total);
    return 0;
}
