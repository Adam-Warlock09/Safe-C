# SafeC compiler - build file
# Needs flex, bison 3.x and a C++17 compiler (the parser is C++).
#
# Targets:
#   make             build the compiler (safec), parser, and lexer
#   make safec       build the full compiler driver
#   make test        run all test suites (lexer, parser, sema, codegen)
#   make test-lexer  run the lexer stage of tests/run_tests.sh (likewise test-parser, test-sema)
#   make test-ir     check the LLVM IR the codegen tests produce
#   make test-codegen build and run the codegen tests
#   make test-interop check SafeC objects linked with C (calling convention)
#   make test-driver  check the command line (-c, -S, -o, -l, ...)
#   make clean       remove build artifacts

CC          = cc
CXX         = c++
CLANG       = clang
FLEX        = flex
BISON       = bison
CFLAGS      = -std=c11 -Wall -Wextra -O2 -Isrc
CXXFLAGS    = -std=c++17 -Wall -Wextra -O2 -I. -Isrc
LEXCFLAGS   = -w -Isrc
YACCCFLAGS  = -w -Isrc -std=c++17

all: safec safec-parser lexer

lex.yy.c: src/lexer.l src/tokens.h
	$(FLEX) -o $@ src/lexer.l

parser.tab.cpp parser.tab.hpp: src/parser.y src/tokens.h
	$(BISON) -d -o parser.tab.cpp src/parser.y

lexer.o: lex.yy.c
	$(CC) $(LEXCFLAGS) -c -o $@ lex.yy.c

lexer-lib.o: lex.yy.c
	$(CC) $(LEXCFLAGS) -DSAFEC_NO_LEXER_MAIN -c -o $@ lex.yy.c

parser.tab.o: parser.tab.cpp src/new_ast.h   # the parser builds the AST: rebuild when its classes change
	$(CXX) $(YACCCFLAGS) -c -o $@ parser.tab.cpp

sema.o: src/sema.cpp src/sema.h src/new_ast.h src/borrowck.h
	$(CXX) $(CXXFLAGS) -c -o $@ src/sema.cpp

main_parser.o: src/main_parser.cpp parser.tab.hpp src/new_ast.h src/ast_dump.h src/sema.h
	$(CXX) $(CXXFLAGS) -c -o $@ src/main_parser.cpp

ast_dump.o: src/ast_dump.cpp src/ast_dump.h src/new_ast.h
	$(CXX) $(CXXFLAGS) -c -o $@ src/ast_dump.cpp

borrowck.o: src/borrowck.cpp src/borrowck.h src/new_ast.h
	$(CXX) $(CXXFLAGS) -c -o $@ src/borrowck.cpp

# The target clang compiles for (triple and data layout), asked from clang
# itself. Codegen writes it into every module so the IR states the target its
# layout and calling convention were generated for. Delete the file (or
# `make clean`) after changing clang.
target_info.h:
	@ir=$$(printf '' | $(CLANG) -x c -S -emit-llvm -o - - 2>/dev/null); \
	triple=$$(printf '%s\n' "$$ir" | sed -n 's/^target triple = "\(.*\)"$$/\1/p'); \
	layout=$$(printf '%s\n' "$$ir" | sed -n 's/^target datalayout = "\(.*\)"$$/\1/p'); \
	if [ -z "$$triple" ]; then \
	    echo "warning: could not get the target from '$(CLANG)'; the IR will have no target triple" >&2; \
	fi; \
	printf '// Generated by the Makefile from $(CLANG). Do not edit.\n#pragma once\n#define SAFEC_TARGET_TRIPLE "%s"\n#define SAFEC_DATALAYOUT "%s"\n' \
	    "$$triple" "$$layout" > $@

codegen_expr.o: src/codegen_expr.cpp src/codegen.h src/new_ast.h target_info.h
	$(CXX) $(CXXFLAGS) -c -o $@ src/codegen_expr.cpp

codegen_abi.o: src/codegen_abi.cpp src/codegen.h src/new_ast.h
	$(CXX) $(CXXFLAGS) -c -o $@ src/codegen_abi.cpp

codegen_debug.o: src/codegen_debug.cpp src/codegen.h src/new_ast.h
	$(CXX) $(CXXFLAGS) -c -o $@ src/codegen_debug.cpp

codegen_stmt.o: src/codegen_stmt.cpp src/codegen.h src/new_ast.h
	$(CXX) $(CXXFLAGS) -c -o $@ src/codegen_stmt.cpp

driver.o: src/driver.cpp parser.tab.hpp src/new_ast.h src/ast_dump.h src/sema.h src/tokens.h src/codegen.h
	$(CXX) $(CXXFLAGS) -c -o $@ src/driver.cpp

safec: driver.o parser.tab.o lexer-lib.o ast_dump.o sema.o borrowck.o codegen_expr.o codegen_stmt.o codegen_abi.o codegen_debug.o
	$(CXX) -o $@ $^

lexer: lexer.o
	$(CC) -o $@ lexer.o

safec-parser: parser.tab.o lexer-lib.o main_parser.o ast_dump.o sema.o borrowck.o codegen_expr.o codegen_stmt.o codegen_abi.o codegen_debug.o
	$(CXX) -o $@ $^

# All tests go through tests/run_tests.sh; these targets run one stage each.
test-lexer:
	bash tests/run_tests.sh --lexer --only

test-parser:
	bash tests/run_tests.sh --parser --only

test-sema:
	bash tests/run_tests.sh --sema --only

test-codegen:
	bash tests/run_tests.sh --safec --only    # builds and runs the codegen programs

test-ir:
	bash tests/run_tests.sh --codegen --only  # only checks the generated LLVM IR

test-interop:
	bash tests/run_tests.sh --interop --only

test-driver:
	bash tests/run_tests.sh --driver --only

test:
	bash tests/run_tests.sh

clean:
	rm -f safec safec-parser lexer lexer.o lexer-lib.o lex.yy.c \
	      parser.tab.o parser.tab.cpp parser.tab.hpp parser.tab.c parser.tab.h \
	      location.hh position.hh stack.hh main_parser.o ast_dump.o sema.o \
	      driver driver.o borrowck.o codegen_expr.o codegen_stmt.o codegen_abi.o codegen_debug.o target_info.h \
	      *.ll a.out *.out

.PHONY: all test test-lexer test-parser test-sema test-ir test-codegen test-interop test-driver clean